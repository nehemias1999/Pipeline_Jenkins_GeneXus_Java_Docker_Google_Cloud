# Template for the runtime-only docker/.env (never commit real values).
# The Jenkins pipeline generates docker/.env from this template +
# Jenkins credentials bindings (db-dev-user, db-dev-pass, gam-db-*) via
# writeFile. This file MUST contain placeholders only, no secrets.
DOCKER_IMAGE_NAME=${DOCKER_IMAGE_NAME}
DOCKER_IMAGE_TAG=${DOCKER_IMAGE_TAG}
DOCKER_CONTAINER_NAME=${DOCKER_CONTAINER_NAME}

DB_URL=${DB_URL}
DB_SCHEMA=${DB_SCHEMA}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}

GAM_DB_URL=${GAM_DB_URL}
GAM_DB_SCHEMA=${GAM_DB_SCHEMA}
GAM_DB_USER=${GAM_DB_USER}
GAM_DB_PASSWORD=${GAM_DB_PASSWORD}
