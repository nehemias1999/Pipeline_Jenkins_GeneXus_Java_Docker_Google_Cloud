# Root pointer to the runtime .env template (placeholders only, no secrets).
# Purpose: document where the deploy-time environment comes from without
# duplicating it. The Jenkins pipeline generates docker/.env from
# docker/.env.template + Jenkins credentials bindings (db-dev-user,
# db-dev-pass, gam-db-*) via writeFile. Never commit real values here.
# Canonical template: docker/.env.template
# See README (setup/credentials) and .gitignore (docker/.env is untracked).
TEMPLATE_FILE=docker/.env.template
